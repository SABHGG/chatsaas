# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will not be committed

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Amazon Cognito (get these after running CDK deploy — see WI-008 stack outputs)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=us-east-1
# The Cognito App Client's domain host (serves the OAuth2 endpoints)
NEXT_PUBLIC_COGNITO_DOMAIN=my-pool.auth.us-east-1.amazoncognito.com
# Optional. Only set when the app client is confidential (client secret enabled).
COGNITO_CLIENT_SECRET=

# JWT verification (issuer and JWKS URL are derived from the vars above):
#   issuer = https://cognito-idp.${NEXT_PUBLIC_COGNITO_REGION}.amazonaws.com/${NEXT_PUBLIC_COGNITO_USER_POOL_ID}
#   jwks   = ${issuer}/.well-known/jwks.json
# The OAuth redirect URI is derived from the request origin: ${origin}/api/auth/callback

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Environment
NODE_ENV=development
