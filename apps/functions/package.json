{
  "name": "@chatsaas/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "dev:sandbox": "tsx watch --env-file-if-exists=.env scripts/sandbox-server.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1116.0",
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/client-rds-data": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-sqs": "^3.1116.0",
    "@aws-sdk/client-ssm": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@aws-sdk/util-dynamodb": "^3.99.0",
    "@chatsaas/core": "workspace:*",
    "@chatsaas/types": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@langchain/aws": "^1.4.4",
    "@neondatabase/serverless": "^1.1.0",
    "fastify": "^5.12.1",
    "jose": "^5.10.0",
    "langchain": "^1.5.10",
    "mammoth": "^1.8.0",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.17.6",
    "aws-sdk-client-mock": "^4.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
